(self, config, stage)
    def prune(self, config, stage):
        device = self.device
        self.zs = self.init_prune_zs(config, stage)
        self.model.prune(self.zs)
        hidden_index = self.zs["hidden_index"]
        new_module = nn.Linear(hidden_index.shape[0], self.lm_head.out_features, bias=self.lm_head.bias is not None)
        new_module.weight.data = torch.index_select(self.lm_head.weight.data, -1, hidden_index)
        self.set_output_embeddings(new_module)

